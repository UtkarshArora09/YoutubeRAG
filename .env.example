# --- Database ---
DATABASE_URL=postgresql+psycopg2://raguser:ragpass@localhost:5432/youtube_rag

# --- Groq (LLM, free tier) ---
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b

# --- Embeddings (local, free, multilingual — no API key needed) ---
